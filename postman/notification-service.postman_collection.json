                  "pm.test('API-L3 is listed', () => pm.expect(summary).to.be.an('object'));",
                  "pm.test('attemptCount is 2', () => pm.expect(summary.attemptCount).to.eql(2));",
                  "pm.test('lastHttpStatus is 503', () => pm.expect(summary.lastHttpStatus).to.eql(503));",
                  "pm.test('eventType is CREDIT_CARD_PAYMENT', () => pm.expect(summary.eventType).to.eql('CREDIT_CARD_PAYMENT'));",
                  "pm.test('status is FAILED', () => pm.expect(summary.status).to.eql('FAILED'));",
                  "pm.test('createdAt is present', () => pm.expect(summary.createdAt).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
