    {
      "name": "Detail",
      "item": [
        {
          "name": "Returns event details with attempt history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('id', () => pm.expect(body.id).to.eql('API-D-OK'));",
                  "pm.test('status is FAILED', () => pm.expect(body.status).to.eql('FAILED'));",
                  "pm.test('attemptCount is 2', () => pm.expect(body.attemptCount).to.eql(2));",
                  "pm.test('lastHttpStatus is 503', () => pm.expect(body.lastHttpStatus).to.eql(503));",
                  "pm.test('webhookUrl is the subscription\\'s', () =>",
                  "    pm.expect(body.webhookUrl).to.eql('https://example.com/' + pm.collectionVariables.get('clientA')));",
                  "pm.test('attempt numbers are 1, 2', () => pm.expect(body.attempts.map(a => a.attempt)).to.eql([1, 2]));",
                  "pm.test('attempt HTTP statuses are 500, 503', () => pm.expect(body.attempts.map(a => a.httpStatus)).to.eql([500, 503]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{clientA}}"
