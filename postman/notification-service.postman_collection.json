{
  "info": {
    "_postman_id": "95e2101c-596f-546e-a02d-43442773008b",
    "name": "notification-service - notification events API",
    "description": "Black-box tests of the notification-events REST API, mirroring the scenarios of NotificationEventControllerIntTest.\n\nSetup (see the README section 'Postman collection'):\n1. Start the service with the dispatcher disabled (--notification.processing.dispatch-enabled=false), so replayed events stay PENDING.\n2. Load postman/seed.sql into the database. The Replay folder consumes the seeded FAILED events, so re-run the seed before every run.\n3. Run the collection (folders in order) with the Collection Runner or newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientA",
      "value": "CLIENT-API-A"
    },
    {
      "key": "clientB",
      "value": "CLIENT-API-B"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Actuator health is UP (database reachable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('overall status UP', () => pm.expect(body.status).to.eql('UP'));",
                  "pm.test('db is UP', () => pm.expect(body.components.db.status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "List",
      "item": [
        {
          "name": "Lists only the calling client's events",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const ids = body.items.map(i => i.id);",
                  "pm.test('contains the calling client\\'s event', () => pm.expect(ids).to.include('API-L1'));",
                  "pm.test('does not contain another client\\'s event', () => pm.expect(ids).to.not.include('API-L2'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{clientA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notification_events?size=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notification_events"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            }
          }
        },
        {
          "name": "Returns pagination metadata",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('page is 0', () => pm.expect(body.page).to.eql(0));",
                  "pm.test('size is 1', () => pm.expect(body.size).to.eql(1));",
                  "pm.test('one item on the page', () => pm.expect(body.items).to.have.lengthOf(1));",
                  "pm.test('totalElements is positive', () => pm.expect(body.totalElements).to.be.above(0));",
                  "pm.test('totalPages = totalElements for size 1', () => pm.expect(body.totalPages).to.eql(body.totalElements));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{clientA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notification_events?page=0&size=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notification_events"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Exposes attempt count and last HTTP status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
