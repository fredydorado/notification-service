            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{clientA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notification_events/API-R-TWICE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notification_events",
                "API-R-TWICE"
              ]
            }
          }
        }
